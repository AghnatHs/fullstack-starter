{
  "name": "fullstack-bun-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "bun": ">=1.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' --parallel dev",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start:api": "bun run --cwd apps/api start",
    "preview": "bun run build && WEB_DIST_DIR=$PWD/apps/web/dist bun run start:api",
    "prepare": "bun scripts/install-git-hooks.mjs",
    "typecheck": "bun run --filter './packages/*' --filter './apps/*' typecheck",
    "lint": "biome lint --error-on-warnings . && bun scripts/module-boundaries.ts",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun test",
    "quality": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.4.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "typescript": "^6.0.3"
  }
}
