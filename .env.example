# Development only. Never use these credentials for production.
POSTGRES_USER=starter
POSTGRES_PASSWORD=starter-local-only
POSTGRES_DB=starter
POSTGRES_PORT=5432
DATABASE_URL=postgresql://starter:starter-local-only@127.0.0.1:5432/starter

API_PORT=3100
WEB_PORT=3000
API_INTERNAL_URL=http://127.0.0.1:3100

# Rate limiting uses Valkey/Redis. Requests fail closed with 503 when it is unavailable.
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60

# Comma-separated proxy IPs or CIDR blocks allowed to supply X-Forwarded-For.
# Leave empty to always use the direct connection address.
TRUSTED_PROXIES=

# Local S3-compatible object storage (S3Mock). Used only when storage is constructed.
# S3Mock accepts any credentials; these values are placeholders.
S3_PORT=9090
S3_ENDPOINT=http://127.0.0.1:9090
S3_REGION=us-east-1
S3_BUCKET=starter-files
S3_ACCESS_KEY_ID=starter
S3_SECRET_ACCESS_KEY=starter-local-only
S3_FORCE_PATH_STYLE=true

# Set to an absolute directory to serve the built SPA from the API process.
# WEB_DIST_DIR=/absolute/path/to/apps/web/dist

PROXY_PORT=8080
